POSTGRES_DB=cyberlab_tracker
POSTGRES_USER=cyberlab
POSTGRES_PASSWORD=replace-with-a-strong-password
BACKEND_PORT=8000
DEBUG=false
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type"]
AUTH_RATE_LIMIT_REQUESTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/chat
OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_ARTIFACT_MODEL=qwen3-coder:30b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_ARTIFACT_TIMEOUT_SECONDS=240
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=2h
OLLAMA_WARMUP_ENABLED=true
MENTOR_ARTIFACT_MAX_PER_USER=20
